# ctest: install into a throwaway prefix and check the launcher entry and the D-Bus file point at THAT prefix.
file(REMOVE_RECURSE "${PREFIX}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${PREFIX}" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "cmake --install failed (${rc})")
endif()
foreach(f share/applications/mobs.desktop share/dbus-1/services/org.mobs.Control.service)
  if(NOT EXISTS "${PREFIX}/${f}")
    message(FATAL_ERROR "missing ${f}")
  endif()
  file(READ "${PREFIX}/${f}" c)
  if(NOT c MATCHES "=${PREFIX}/bin/mobs")
    message(FATAL_ERROR "${f} does not point at ${PREFIX}/bin/mobs:\n${c}")
  endif()
  if(c MATCHES "@MOBS_BIN@" OR c MATCHES "/usr/local/bin/mobs")
    message(FATAL_ERROR "${f} still has a placeholder or the default prefix:\n${c}")
  endif()
endforeach()
foreach(f bin/mobs share/icons/hicolor/scalable/apps/mobs.svg)
  if(NOT EXISTS "${PREFIX}/${f}")
    message(FATAL_ERROR "missing ${f}")
  endif()
endforeach()

if(EXISTS "${BUILD_DIR}/obs-nvenc-test" AND NOT EXISTS "${PREFIX}/bin/obs-nvenc-test")
  message(FATAL_ERROR "NVIDIA helper was built but not installed beside MOBS")
endif()

# The INSTALLED binary must actually start and draw its window. (A module-name clash once made the installed copy exit with
# "Module Mobs contains no type named Main" while the build-directory copy worked, because only the latter sat next to a qmldir.)
set(ENV{QT_QPA_PLATFORM} offscreen)
set(ENV{QT_QPA_PLATFORMTHEME} generic)
set(ENV{QT_QUICK_BACKEND} software)
set(ENV{MOBS_NO_HOTKEY} 1)
set(ENV{MOBS_FAKE_AUDIO} 1)
set(ENV{QT_IM_MODULE} none)
# Nothing of the person's is touched by this run: it used to read their real settings and stream key, open their real camera for a second, share their X
# browser profile and write into their real log (every ctest run did, while MOBS itself was open). Cameras are stand-ins, and every file and folder is in the
# throwaway prefix, the same set check_ui.py uses for each scenario. A name of its own for the control interface keeps it clear of a MOBS that is running.
set(ENV{MOBS_FAKE_CAMERAS} 1)
set(ENV{MOBS_TEST_CAMERA} colour)
set(ENV{MOBS_TEST_SOURCE} colour)
set(ENV{MOBS_NO_OPEN} 1)
set(ENV{MOBS_STREAM_KEY_FILE} "${PREFIX}/test-stream-key")
set(ENV{MOBS_TOKEN_FILE} "${PREFIX}/test-token")
set(ENV{MOBS_THEME_DIR} "${PREFIX}/test-theme")
set(ENV{MOBS_WEB_DIR} "${PREFIX}/test-web")
set(ENV{MOBS_LOG_FILE} "${PREFIX}/test.log")
set(ENV{MOBS_CONTROL_NAME} org.mobs.InstallTest)
set(ENV{MOBS_SETTINGS} "${PREFIX}/test-settings.ini")
set(ENV{MOBS_GRAB} "${PREFIX}/grab.png")
set(ENV{MOBS_GRAB_MS} 600)
execute_process(COMMAND "${PREFIX}/bin/mobs" RESULT_VARIABLE run_rc OUTPUT_QUIET ERROR_VARIABLE run_err TIMEOUT 40)
if(NOT run_rc EQUAL 0)
  message(FATAL_ERROR "the installed ${PREFIX}/bin/mobs exited with ${run_rc}\n${run_err}")
endif()
if(NOT EXISTS "${PREFIX}/grab.png")
  message(FATAL_ERROR "the installed binary ran but drew no window")
endif()
# And the run really was isolated: it wrote its own log, and used a stand-in camera, never a real one.
if(NOT EXISTS "${PREFIX}/test.log")
  message(FATAL_ERROR "the run wrote no log of its own: it was not kept apart from the person's real files")
endif()
file(READ "${PREFIX}/test.log" run_log)
if(run_log MATCHES "webcam window shown: camera")
  message(FATAL_ERROR "the install check opened a real camera:\n${run_log}")
endif()
